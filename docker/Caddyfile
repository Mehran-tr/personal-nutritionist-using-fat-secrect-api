# TLS termination + load balancing in front of the API.
# Caddy obtains and renews certificates automatically, redirects HTTP -> HTTPS,
# and uses TLS 1.2/1.3 with modern AEAD cipher suites only by default.
{$DOMAIN} {
	# zstd/gzip at the edge (the app also compresses; Caddy won't double-encode).
	encode zstd gzip

	# The app sends HSTS itself (SECURITY__HSTS_ENABLED=true). Strip the
	# proxy's own fingerprint.
	header -Server

	# Don't let clients reach internal endpoints through the public entrypoint.
	@internal path /health/ready /metrics /docs* /openapi.json
	respond @internal 404

	reverse_proxy {
		# Every replica of `api` (docker compose up --scale api=N), re-resolved.
		dynamic a api 8000 {
			refresh 10s
		}
		lb_policy least_conn
		lb_retries 2
		# Active health checks: unhealthy replicas leave the pool automatically.
		health_uri /health/live
		health_interval 5s
		health_timeout 2s
		# Passive: a replica that fails requests is benched briefly.
		fail_duration 30s
		# Reuse upstream connections (keep-alive). The app keeps them for 75 s.
		transport http {
			keepalive 60s
			keepalive_idle_conns 64
		}
	}
}
