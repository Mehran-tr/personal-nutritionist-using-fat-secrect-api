# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# fatsecret Platform API — https://platform.fatsecret.com (Manage API Keys)
FATSECRET__CLIENT_ID=
FATSECRET__CLIENT_SECRET=
FATSECRET__SCOPES=premier
# Optional localisation, e.g. DE / de
# FATSECRET__REGION=DE
# FATSECRET__LANGUAGE=de

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__JWT_SECRET=
AUTH__ACCESS_TOKEN_TTL_MINUTES=30

# PostgreSQL (compose overrides the host to "postgres")
DATABASE__URL=postgresql+asyncpg://nutritionist:nutritionist@localhost:5432/nutritionist

# redis (default) or memory (single process, dev only)
CACHE__BACKEND=redis
CACHE__REDIS_URL=redis://localhost:6379/0
